# ═══════════════════════════════════════════════════════════
# Remotion Video — TTS 语音合成 Provider 配置
# ═══════════════════════════════════════════════════════════
# 复制本文件为 .env，填入你使用的 TTS 平台配置。
# 语音合成是可选步骤——不配置则生成无音频的纯动画视频。
#
# 选择 provider: openai 或 edge
# ═══════════════════════════════════════════════════════════

TTS_PROVIDER=openai

# ── OpenAI 兼容（官方 / 硅基流动 / 火山方舟 / OneAPI 等）──────────
# 所有兼容 OpenAI Audio Speech API (/v1/audio/speech) 的平台都用这一个 provider，
# 通过 TTS_BASE_URL 切换平台，请求/响应格式统一。
#
# OpenAI 官方:    TTS_BASE_URL=https://api.openai.com/v1
# 硅基流动:       TTS_BASE_URL=https://api.siliconflow.cn/v1
# 火山方舟:       TTS_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OneAPI/New API: TTS_BASE_URL=https://your-gateway.com/v1
#
TTS_API_KEY=your_api_key_here
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# TTS_RESPONSE_FORMAT=mp3       # mp3/opus/aac/flac/wav/pcm
# TTS_SPEED=1.0                  # 仅 tts-1/tts-1-hd 有效，0.25-4.0
# TTS_INSTRUCTIONS=              # 仅 gpt-4o-mini-tts 有效，语气指令
# TTS_GAIN=                      # 部分 SiliconFlow 模型支持，增益 dB [-10,10]
# TTS_SAMPLE_RATE=               # 采样率覆盖（如 44100/48000）

# ── Edge TTS（免费本地，无需 API Key）─────────────────────
# 需要 pip install edge-tts
# 固定输出 MP3，不支持其他格式
# 支持数百种 Neural 语音，常用：
#   中文: zh-CN-XiaoxiaoNeural(女) zh-CN-YunxiNeural(男) zh-CN-XiaoyiNeural(女)
#   英文: en-US-AriaNeural(女) en-US-GuyNeural(男)
#
# 切换到 Edge TTS 时设 TTS_PROVIDER=edge，然后：
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_RATE=+0%      # 如 -20%, +50%
# TTS_VOLUME=+0%
# TTS_PITCH=+0Hz    # 如 -50Hz, +10Hz

# ── MiMo TTS（小米 MiMo，Chat Completions 格式）─────────
# 与 OpenAI /v1/audio/speech 不同，MiMo 用 /v1/chat/completions：
#   - 合成文本放在 messages[].role=assistant 的 content
#   - 风格/语气指令放在 messages[].role=user 的 content
# 获取: https://api.xiaomimimo.com/
#
# 切换到 MiMo 时设 TTS_PROVIDER=mimo，然后：
# MIMO_API_KEY=your_mimo_key
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-tts
# MIMO_VOICE=冰糖                  # 预置音色: mimo_default/冰糖/茉莉/苏打/白桦/Mia/Chloe/Milo/Dean
# MIMO_FORMAT=wav                  # wav 或 pcm16
# MIMO_AUTH_MODE=api-key           # api-key（默认）或 bearer
# MIMO_STYLE=                       # 可选，覆盖默认课程讲解风格指令
# # 音色设计模式 (model=mimo-v2.5-tts-voicedesign):
# # MIMO_VOICE_DESIGN_PROMPT=年轻女性，温柔亲切，适合教学讲解
# # 音色克隆模式 (model=mimo-v2.5-tts-voiceclone):
# # MIMO_VOICE_SAMPLE_PATH=/path/to/sample.wav   # 3-10秒参考音频
