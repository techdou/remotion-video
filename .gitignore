# ═══════════════════════════════════════════════════════════
# .gitignore — Remotion Video 项目服务
# 原则：敏感信息不泄露、开发配置不上传、运行时产物不提交
# ═══════════════════════════════════════════════════════════

# ── Node.js ──────────────────────────────────────────────
node_modules/

# ── 构建产物（tsup / esbuild 输出）──────────────────────
dist/
web-ui/public/app.js
web-ui/public/app.js.map
tsconfig.tsbuildinfo

# ── SQLite 数据库（运行时生成）──────────────────────────
.data/
*.db
*.db-shm
*.db-wal

# ── 敏感信息 / API 密钥（绝不入库）──────────────────────
.env
.env.*
!.env.example
*.secret
*_api_key*
*_token*
*_apikey*
credentials.json
secrets.json
*.pem
*.key
*.pfx
*.keystore
# API / 访问令牌
*.netrc

# ── 生成产物（视频/音频/项目输出）──────────────────────
out/
*.mp4
*.webm
*.mov
*.mkv

# 工作流运行时生成的项目
remotion-video-projects/
scene-plans/

# TTS 运行时产物
speech/
speech-manifest.json
public/audio.mp3
*.wav
*.mp3
!template/**/*.mp3
!examples/**/*.wav

# ── 开发软件配置目录（不上传）──────────────────────────
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
.project
.settings/
.eslintcache

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.Python
pip-log.txt

# ── 操作系统 ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ── 日志 / 临时文件 ──────────────────────────────────────
*.log
.tmp/
tmp/
